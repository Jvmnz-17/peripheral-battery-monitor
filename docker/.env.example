# Copy this file to ".env" and adjust the paths for your Windows user.
# MCHOSE HUB stores its device state here:
MCHOSE_CONFIG_DIR=C:/Users/<your-user>/AppData/Roaming/MCHOSEHUB/files/config

# RapooGameDev writes its hourly logs here:
RAPOO_LOG_DIR=C:/Users/<your-user>/AppData/Local/RapooGameDev/Log
